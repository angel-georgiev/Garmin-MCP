# Copy to .env and fill in. Never commit the real .env.

# Garmin Connect account credentials.
# Only needed for the first login (`garmin-mcp login`); afterwards the server
# runs off the cached OAuth tokens and you can remove the password again.
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-password

# Where OAuth tokens are cached. Defaults to ~/.garminconnect
# GARMINTOKENS=~/.garminconnect

# Set to 1 for Garmin China accounts (garmin.cn)
# GARMIN_IS_CN=0

# Maximum characters of JSON a single tool may return before it is trimmed.
# Raise it if you want more raw data per call, lower it to save context.
# GARMIN_MCP_MAX_CHARS=40000

# Directory used by download_activity when no output path is given.
# GARMIN_MCP_DOWNLOAD_DIR=~/garmin-downloads

# --- Claude connector (remote MCP over HTTPS) ---
# Both must be set together to enable OAuth. The passphrase is a NEW secret you
# choose, not your Garmin password; minimum 12 characters.
# GARMIN_MCP_AUTH_PASSPHRASE=change-me-to-something-long
# GARMIN_MCP_PUBLIC_URL=https://your-tunnel.trycloudflare.com
